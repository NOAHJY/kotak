<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9ECEF"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- KOLOM KIRI (GELAP): JOYSTICK GERAK UTAMA (1 JOYSTICK ONLY) & CAPIT -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/card_dark"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GERAK ▲ ▼ ◄ ► (X, Y)"
            android:textColor="#9AA0A6"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.example.robotkotak222.JoystickView
            android:id="@+id/joystick_move"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="#33FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CAPIT (GRIP)"
            android:textColor="#9AA0A6"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/grip_close_btn"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/btn_round"
                    android:gravity="center"
                    android:text="J"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Jepit"
                    android:textColor="#CFD8DC"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/grip_open_btn"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/btn_round"
                    android:gravity="center"
                    android:text="B"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Buka"
                    android:textColor="#CFD8DC"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- KOLOM TENGAH (PANEL TERANG): ROBOT CONTROLLER & KONEKSI WIFI -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1.2"
        android:orientation="vertical"
        android:theme="@style/ThemeOverlay.AppCompat.Light">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ROBOT CONTROLLER"
            android:textColor="#111111"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/status_dot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textColor="#F44336"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/status_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Belum terhubung"
                android:textColor="#263238"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="KONEKSI WIFI (ESP8266 / ESP32)"
            android:textColor="#607D8B"
            android:textSize="9sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/ip_input"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="2"
                android:background="#FFFFFF"
                android:hint="IP: 192.168.4.1"
                android:inputType="text"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="192.168.4.1"
                android:textColor="#111111"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/port_input"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:hint="Port"
                android:inputType="number"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="8888"
                android:textColor="#111111"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/connect_btn"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#FF4FA0"
            android:padding="0dp"
            android:text="Hubungkan WiFi"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="ARAH (KOORDINAT X, Y)"
            android:textColor="#607D8B"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/arah_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:minLines="2"
            android:text="STOP (X:0, Y:0)"
            android:textColor="#FF4FA0"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="PERINTAH DIKIRIM"
            android:textColor="#607D8B"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cmd_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/box_cmd"
            android:fontFamily="monospace"
            android:minLines="2"
            android:padding="6dp"
            android:text="0,0,STOP,NONE,0,NONE,NONE"
            android:textColor="#A5D6A7"
            android:textSize="10sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/stop_btn"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#D32F2F"
            android:padding="0dp"
            android:text="STOP"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- KOLOM KANAN (GELAP): D-PAD (ATAS, KIRI, KANAN, BAWAH) di atas, LIFT (NAIK/TURUN) di bawah -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/card_dark"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MAJU/MUNDUR ▲ ▼  PUTAR ◄ ►"
            android:textColor="#9AA0A6"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- D-PAD 4 ARAH (GRID 3x3): Atas, Kiri, Kanan, Bawah -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="2dp"
            android:layout_weight="1">

            <GridLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:columnCount="3"
                android:rowCount="3">

                <!-- Row 0, Col 1: Up -->
                <TextView
                    android:id="@+id/btn_dpad_up"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_row="0"
                    android:layout_column="1"
                    android:layout_gravity="center"
                    android:background="@drawable/btn_round"
                    android:gravity="center"
                    android:text="▲"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Row 1, Col 0: Left -->
                <TextView
                    android:id="@+id/btn_dpad_left"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_row="1"
                    android:layout_column="0"
                    android:layout_gravity="center"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/btn_round"
                    android:gravity="center"
                    android:text="◄"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Row 1, Col 2: Right -->
                <TextView
                    android:id="@+id/btn_dpad_right"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_row="1"
                    android:layout_column="2"
                    android:layout_gravity="center"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/btn_round"
                    android:gravity="center"
                    android:text="►"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Row 2, Col 1: Down -->
                <TextView
                    android:id="@+id/btn_dpad_down"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_row="2"
                    android:layout_column="1"
                    android:layout_gravity="center"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/btn_round"
                    android:gravity="center"
                    android:text="▼"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </GridLayout>
        </FrameLayout>


    </LinearLayout>

</LinearLayout>
